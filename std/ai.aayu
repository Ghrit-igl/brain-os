# ==============================================================================
# AAYU Standard Library: AI & Neural Networks (std/ai.aayu)
# 100% Pure AAYU - Modern Deep Learning, Transformers & Vector RAG
# Zero Python, Zero External Dependencies, Silicon Speed
# ==============================================================================

# Matrix x Vector multiplication in pure AAYU
action mat_vec_mul(matrix, vec)
    let out = []
    let rows = len(matrix)
    let r = 0
    while r < rows
        let row = matrix[r]
        let sum = 0.0
        let c = 0
        let cols = len(row)
        while c < cols
            sum = sum + (row[c] * vec[c])
            c = c + 1
        end
        out = out + [sum]
        r = r + 1
    end
    return out
end

# Vector addition
action vec_add(v1, v2)
    let out = []
    let l1 = len(v1)
    let i = 0
    while i < l1
        out = out + [v1[i] + v2[i]]
        i = i + 1
    end
    return out
end

# Vector scaling
action vec_scale(v, scalar)
    let out = []
    let l = len(v)
    let i = 0
    while i < l
        out = out + [v[i] * scalar]
        i = i + 1
    end
    return out
end

# Mean Squared Error (MSE) Loss
action mse_loss(preds, targets)
    let n = len(preds)
    if n == 0
        return 0.0
    end
    let total_sq_err = 0.0
    let i = 0
    while i < n
        let diff = preds[i] - targets[i]
        total_sq_err = total_sq_err + (diff * diff)
        i = i + 1
    end
    return total_sq_err / (n * 1.0)
end

# Cross-Entropy Loss from probability distribution and integer class label
action cross_entropy_loss(probs, target_idx)
    let p = probs[target_idx]
    if p < 0.000000000001
        p = 0.000000000001
    end
    # Using math_ln native fast path or pure ln fallback
    let log_p = math_ln(p)
    return 0.0 - log_p
end

# Dense Linear Layer Forward Pass: y = (x * W) + b
action linear_layer_forward(x_tensor, weights_tensor, bias_tensor)
    let xw = tensor_matmul(x_tensor, weights_tensor)
    return tensor_add(xw, bias_tensor)
end

# Transformer Feed-Forward Network (FFN):
# FFN(x) = GELU(x * W1 + b1) * W2 + b2
action transformer_ffn_forward(x_tensor, w1, b1, w2, b2)
    let h1 = linear_layer_forward(x_tensor, w1, b1)
    let h1_act = tensor_gelu(h1)
    return linear_layer_forward(h1_act, w2, b2)
end

# Transformer Scaled Dot-Product Attention Forward Pass:
# Attention(Q, K, V) = Softmax((Q * K^T) / scale) * V
action attention_forward(q_tensor, k_tensor, v_tensor, scale)
    return tensor_attention(q_tensor, k_tensor, v_tensor, scale)
end

# Transformer Encoder Layer Forward Pass:
# 1. Attn = x + Attention(LayerNorm(x))
# 2. Out = Attn + FFN(LayerNorm(Attn))
action transformer_encoder_block(x, w_q, w_k, w_v, w_out, w_ffn1, b_ffn1, w_ffn2, b_ffn2)
    # Pre-LayerNorm
    let norm1 = tensor_layernorm(x, 0, 0, 0.00001)
    let q = tensor_matmul(norm1, w_q)
    let k = tensor_matmul(norm1, w_k)
    let v = tensor_matmul(norm1, w_v)
    
    let attn_out = tensor_attention(q, k, v, 0.125)
    let attn_proj = tensor_matmul(attn_out, w_out)
    let x_after_attn = tensor_add(x, attn_proj)
    
    # Pre-LayerNorm for FFN
    let norm2 = tensor_layernorm(x_after_attn, 0, 0, 0.00001)
    let ffn_out = transformer_ffn_forward(norm2, w_ffn1, b_ffn1, w_ffn2, b_ffn2)
    return tensor_add(x_after_attn, ffn_out)
end

# Vector RAG & Semantic Embedding Search
# Finds top matching document index given a query embedding vector
action vector_search_nearest(query_vec, doc_vectors)
    let n = len(doc_vectors)
    if n == 0
        return -1
    end
    let best_idx = 0
    let best_sim = -2.0
    let i = 0
    while i < n
        let sim = cosine_similarity(query_vec, doc_vectors[i])
        if sim > best_sim
            best_sim = sim
            best_idx = i
        end
        i = i + 1
    end
    return {
        "index": best_idx,
        "similarity": best_sim
    }
end

# Stochastic Gradient Descent (SGD) with Momentum update step
action sgd_momentum_step(weights, grads, velocities, lr, momentum)
    let n = len(weights)
    let new_weights = []
    let new_velocities = []
    let i = 0
    while i < n
        let v = (momentum * velocities[i]) - (lr * grads[i])
        new_velocities = new_velocities + [v]
        new_weights = new_weights + [weights[i] + v]
        i = i + 1
    end
    return {
        "weights": new_weights,
        "velocities": new_velocities
    }
end

# Adam Optimizer update step
action adam_step(params, grads, m, v, t, lr, beta1, beta2, eps)
    let n = len(params)
    let new_params = []
    let new_m = []
    let new_v = []
    let i = 0
    
    # Compute bias correction terms
    let beta1_t = math_pow(beta1, t * 1.0)
    let beta2_t = math_pow(beta2, t * 1.0)
    let corr1 = 1.0 - beta1_t
    let corr2 = 1.0 - beta2_t
    
    while i < n
        let g = grads[i]
        # Update biased first moment estimate: m = beta1 * m + (1 - beta1) * g
        let next_m = (beta1 * m[i]) + ((1.0 - beta1) * g)
        new_m = new_m + [next_m]
        
        # Update biased second moment estimate: v = beta2 * v + (1 - beta2) * g^2
        let next_v = (beta2 * v[i]) + ((1.0 - beta2) * g * g)
        new_v = new_v + [next_v]
        
        # Compute bias-corrected estimates
        let m_hat = next_m / corr1
        let v_hat = next_v / corr2
        
        # Parameter update: p = p - lr * m_hat / (sqrt(v_hat) + eps)
        let step = (lr * m_hat) / (math_sqrt(v_hat) + eps)
        new_params = new_params + [params[i] - step]
        
        i = i + 1
    end
    
    return {
        "params": new_params,
        "m": new_m,
        "v": new_v
    }
end

# Multi-Layer Perceptron (MLP) Fraud & Anomaly Scoring Pipeline
action mlp_forward_pass(features)
    let x0 = features[0]
    let x1 = features[1]
    let x2 = features[2]
    let x3 = features[3]

    # Hidden Layer 1: ReLU activations
    let h1_0 = (x0 * 0.45) - (x2 * 0.12) + 0.05
    if h1_0 < 0.0
        h1_0 = 0.0
    end

    let h1_1 = (x1 * 0.04) + (x3 * 0.35) - 0.10
    if h1_1 < 0.0
        h1_1 = 0.0
    end

    let h1_2 = (x2 * 0.88) - 0.20
    if h1_2 < 0.0
        h1_2 = 0.0
    end

    let h1_3 = (x0 * 0.20) + (x1 * 0.01) + 0.15
    if h1_3 < 0.0
        h1_3 = 0.0
    end

    # Hidden Layer 2: Sigmoid activations via continuous math
    let s2_0 = 1.0 / (1.0 + math_exp(0.0 - (((h1_0 * 0.50) - (h1_1 * 0.30)) * 0.5)))
    let s2_1 = 1.0 / (1.0 + math_exp(0.0 - (((h1_1 * 0.40) - (h1_2 * 0.60)) * 0.5)))
    let s2_2 = 1.0 / (1.0 + math_exp(0.0 - (((h1_3 * 0.30) + 0.10) * 0.5)))

    # Output Layer: Anomaly / Fraud Probability Score [0.0 - 1.0]
    let fraud_score = (s2_0 * 0.35) + (s2_1 * 0.45) - (s2_2 * 0.15)
    if x2 > 0.60
        fraud_score = fraud_score + 0.35
    end

    if fraud_score < 0.01
        fraud_score = 0.01
    end
    if fraud_score > 0.99
        fraud_score = 0.99
    end

    return {
        "score": fraud_score,
        "h1": [h1_0, h1_1, h1_2, h1_3],
        "h2": [s2_0, s2_1, s2_2],
        "is_safe": fraud_score < 0.25
    }
end
